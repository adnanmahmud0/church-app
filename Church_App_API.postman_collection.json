              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@email.com\" // required\n  }"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
