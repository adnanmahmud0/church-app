              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"your_refresh_token_string\" // optional if stored in cookies\n  }"
            }
          }
        },
        {
          "name": "Forget Password",
          "request": {
            "method": "POST",
            "header": [
              {
