                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"newPassword\": \"newPassword123\",    // required\n    \"confirmPassword\": \"newPassword123\" // required\n  }"
            }
          }
        },
